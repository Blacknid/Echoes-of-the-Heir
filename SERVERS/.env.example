# ---------------------------------------------------------------------------
# Michi's Adventure — server secrets.
#
#   cp .env.example .env      then fill in the values below.
#
# .env is gitignored. NEVER commit the real file — every value here is a secret.
# docker-compose reads it automatically (`docker compose up -d --build`).
# ---------------------------------------------------------------------------

# Shared secret between save_server and multiplayer_server, so the MP server can ask
# "is this player's license real?" over the internal (non-internet-facing) license API.
# The two MUST match, or every multiplayer login fails.
#
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MICHI_INTERNAL_API_KEY=

# --- itch.io gate ----------------------------------------------------------------
# NOTE: the game is FREE ($0), so this is an IDENTITY gate, not a purchase gate.
# itch does NOT mint a download key for a free download (only a purchase or an explicit
# claim does), so "does this user hold a download key?" is the wrong question to gate on —
# it would refuse virtually every legitimate player. See SERVERS/LICENSING.md.
#
# Your itch.io API key: https://itch.io/user/settings/api-keys  (press "Generate new key")
# This is YOUR developer key, not a player's. It never leaves the server and is never
# shipped to clients — it is what lets the server ask itch about a user's download keys.
#
# If this is left empty, the gate is DISABLED entirely and the server will hand a license
# to anyone who asks, with no itch account required. Set it before launch.
MICHI_ITCH_API_KEY=

# The NUMERIC id of the game on itch.io — not the URL slug.
# Find it at: https://itch.io/game/edit/<this-number>  (or the "id" field in the API).
MICHI_ITCH_GAME_ID=

# Numeric itch.io user id(s) that always pass the purchase gate, comma-separated.
# itch.io's download_keys API only returns *claimed purchase* keys — the game's own
# developer/admin never holds one for their own game, so without this you (the owner)
# would be locked out of your own gated build. Find your id at https://itch.io/api/1/key/me
# (or in the OAuth /me response). Optional — leave empty if not needed.
#
# NOTE: this alone is NOT enough for the owner, because itch never issues an OAuth
# access_token to an account unless it bought the game through the storefront — the
# developer's own account can't complete the browser flow to get a token in the first
# place. Use MICHI_ITCH_OWNER_SECRET below instead/in addition.
MICHI_ITCH_OWNER_USER_IDS=

# A secret YOU generate (not an itch value) that lets the owner activate without ever
# going through itch OAuth. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# Then, on the OWNER's machine only, put the SAME value (trimmed, one line) in a file
# named owner_secret.dat next to the game executable/jar. The client sends it as the
# itch_token and this server accepts it without ever calling itch.
#
# IMPORTANT: this only takes effect when the gate is ON — i.e. MICHI_ITCH_API_KEY
# and MICHI_ITCH_GAME_ID above are BOTH set. With the gate off, the server never runs the
# ownership check at all (it hands out free licenses), so this secret is ignored.
# Leave empty to disable this path entirely.
MICHI_ITCH_OWNER_SECRET=

# Require a CLAIMED/purchased itch download key, not just a valid itch account?
#
# Leave false while the game is free. itch does not create a download key for a free
# download, so true here refuses everyone who simply pressed "Download" — they'd get
# ITCH_NOT_OWNED despite having done nothing wrong. Only set true if the game is paid, or
# if claiming is enabled AND you are willing to require every player to claim it first.
# Read per-ACTIVATE, so flipping it needs only a server restart, never a client update.
MICHI_ITCH_REQUIRE_DOWNLOAD_KEY=false

# --- Admin dashboard --------------------------------------------------------------
# Password for the MP admin dashboard. docker-compose binds it to the VPS loopback only,
# so reach it through an SSH tunnel rather than exposing it:
#   ssh -L 8888:127.0.0.1:8888 root@142.93.103.51
#   then open http://127.0.0.1:8888/
# Leave empty to disable the dashboard entirely.
MICHI_ADMIN_PASSWORD=
